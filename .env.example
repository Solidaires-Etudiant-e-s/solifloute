# Copy to .env and fill in. Never commit the real .env.

# --- Video processing caps (bytes, seconds, counts) ---
# PROCESS_MAX_VIDEO_UPLOAD_BYTES=1073741824
# PROCESS_MAX_METADATA_UPLOAD_BYTES=268435456
# PROCESS_METADATA_MAX_CONCURRENCY=2
# PROCESS_JOB_CONCURRENCY=1
# PROCESS_JOB_LIMIT_PER_OWNER=5
# PROCESS_JOB_TIMEOUT_MS=7200000
# PROCESS_JOB_RESUME_MAX=2
# PROCESS_JOB_PREEMPTION_RATIO=2
# PROCESS_JOB_PREEMPTION_MAX_PROGRESS=0.95
# PROCESS_JOB_PREEMPTION=false
# PROCESS_VIDEO_OUTPUT_DIR=
# PROCESS_VIDEO_DEBUG_DUMP=

# --- Paths (optional overrides) ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Modal cloud processing ---
# MODAL_VIDEO_URL=
# MODAL_DETECT_URL=
# MODAL_PREPARE_URL=
# MODAL_KEY=
# MODAL_SECRET=
# MODAL_TIMEOUT_MS=1800000